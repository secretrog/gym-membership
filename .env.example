# Railway auto-injects DATABASE_URL when you add a PostgreSQL plugin
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Change this to a strong random string in production
JWT_SECRET="your-secure-secret-here"

# Railway auto-assigns PORT, no need to set manually
PORT=5000

# Default Admin credentials for database seeding
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
